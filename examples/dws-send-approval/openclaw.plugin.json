{
  "id": "dws-send-approval",
  "name": "DWS Reply Assistant",
  "description": "Owner-controlled DingTalk reply assistant with cards and preauthorized exact answers.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ownerUserId", "profile", "dwsPath", "listener"],
    "properties": {
      "agentId": {
        "type": "string",
        "default": "main",
        "pattern": "^[a-z0-9_-]+$"
      },
      "accountId": {
        "type": "string",
        "default": "default"
      },
      "ownerUserId": {
        "type": "string",
        "minLength": 1
      },
      "profile": {
        "type": "string",
        "minLength": 1
      },
      "dwsPath": {
        "type": "string",
        "minLength": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 600000,
        "default": 120000
      },
      "listener": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["all-direct", "all-group", "at-me", "sender", "group", "all-direct-and-at-me"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "ignoreSenderOpenIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Seed only on first start; employee preferences persist separately. Default off."
          }
        }
      },
      "mode": {
        "type": "string",
        "enum": ["approval", "block"],
        "default": "approval"
      },
      "assistant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "cardTemplateId": {
            "type": "string"
          },
          "draftTtlMinutes": {
            "type": "integer",
            "minimum": 10,
            "maximum": 10080,
            "default": 1440
          },
          "cardTtlMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 30,
            "description": "Card interaction lifetime in minutes; navigation does not extend it."
          }
        }
      }
    }
  }
}
